# Kopyalayıp .env olarak kaydedin. .env dosyası git'e gönderilmez.
# Hiçbiri zorunlu değil: LLM yoksa Dayanak alıntı moduyla çalışır.

# Varsayılan: bilgisayarınızda çalışan ücretsiz Ollama (https://ollama.com)
#   ollama pull qwen2.5:7b     -> yazılı cevaplar
#   ollama pull bge-m3         -> çok dilli anlamsal arama
DAYANAK_LLM_BASE_URL=http://localhost:11434/v1
DAYANAK_LLM_API_KEY=ollama
DAYANAK_LLM_MODEL=qwen2.5:7b
DAYANAK_EMBED_MODEL=bge-m3

# Belgelerin saklandığı klasör
DAYANAK_DATA_DIR=data

# OpenAI örneği:
# DAYANAK_LLM_BASE_URL=https://api.openai.com/v1
# DAYANAK_LLM_API_KEY=sk-...
# DAYANAK_LLM_MODEL=<sağlayıcının güncel model adı>
# DAYANAK_EMBED_MODEL=<sağlayıcının embedding modeli>
